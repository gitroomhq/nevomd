---
/**
 * A workbench for looking at the 3D models from several angles. Dev only: in a production
 * build getStaticPaths returns nothing, so no page is generated.
 */
export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return ['models', 'brain', 'icons', 'big'].map((view) => ({ params: { view } }));
}
const { view } = Astro.params;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Lab: {view}</title>
    <style>
      body {
        margin: 0;
        background: #fff;
      }
      canvas {
        display: block;
        width: 1200px;
        height: 1200px;
      }
      body.grey {
        background: #f7f7f7;
      }
    </style>
  </head>
  <body data-view={view}>
    <canvas id="lab"></canvas>
    <script>
      import { createSceneRenderer, type Sprite } from '../../brain/three/renderer';
      import type { ModelName } from '../../brain/three/models';

      const canvas = document.querySelector<HTMLCanvasElement>('#lab')!;
      const renderer = createSceneRenderer(canvas)!;
      const view = document.body.dataset.view;
      const params = new URLSearchParams(location.search);
      const t0 = Number(params.get('t') ?? 0);
      const sprites: Sprite[] = [];

      if (view === 'models') {
        const names: ModelName[] = ['brain', 'radar', 'antenna', 'tactics', 'rocket'];
        const cell = 1000 / 6;
        names.forEach((model, r) => {
          for (let c = 0; c < 6; c++) {
            sprites.push({ model, x: (c + 0.5) * cell, y: (r + 0.5) * cell, size: cell * 0.98, turns: t0 + c / 6, lit: [1, 1, 1, 1] });
          }
        });
      } else if (view === 'brain') {
        for (let i = 0; i < 9; i++) {
          sprites.push({
            model: 'brain',
            x: ((i % 3) + 0.5) * 333.3,
            y: (Math.floor(i / 3) + 0.5) * 333.3,
            size: 330,
            turns: t0 + i / 9,
            lit: i < 3 ? [0, 0, 0, 0] : [1, 1, 1, 1],
          });
        }
      } else if (view === 'big') {
        // One model, filling the canvas: for judging the line work up close.
        const lit = Number(params.get('lit') ?? 0);
        sprites.push({ model: (params.get('model') ?? 'brain') as ModelName, x: 500, y: 500, size: 1000, turns: t0, lit: [lit, lit, lit, lit] });
      } else {
        const names: ModelName[] = ['radar', 'antenna', 'tactics', 'rocket'];
        names.forEach((model, r) => {
          for (let c = 0; c < 4; c++) {
            sprites.push({ model, x: (c + 0.5) * 250, y: (r + 0.5) * 250, size: 245, turns: t0 + c / 4 });
          }
        });
      }

      renderer.resize(2400);
      renderer.draw(sprites, Number(params.get('line') ?? 4.4));
      document.body.dataset.ready = 'true';
    </script>
  </body>
</html>
