---
import { faq } from '../content/site';
---

<section class="band faq-band" id="faq">
  <div class="wrap">
    <div class="band__head">
      <h2 class="h2">Questions</h2>
    </div>

    <div class="faq">
      {
        faq.map((item) => (
          <details>
            <summary>
              <span>{item.q}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 2v12M2 8h12" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 47.5rem;
    margin-inline: auto;
    display: grid;
    gap: 0.625rem;
  }

  details {
    background: var(--band);
    border-radius: var(--radius);
    padding: 0 1.375rem;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    transition: rotate 0.15s ease;
  }

  summary path {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  details[open] summary svg {
    rotate: 45deg;
  }

  details p {
    padding-bottom: 1.25rem;
    max-width: 38em;
  }

  /*
   * When the lights go off at the bottom of the page (scripts/night.ts), the questions go dark
   * with the room under them, as the questions do at the end of lemonade.com/life: the page's
   * paper takes the room's colour, frame by frame, and the questions dim to a fifth.
   */
  .faq-band {
    background: var(--night-paper, transparent);
  }

  .faq-band > .wrap {
    opacity: calc(1 - 0.8 * var(--night, 0));
  }

  @media (prefers-reduced-motion: reduce) {
    summary svg {
      transition: none;
    }
  }
</style>
