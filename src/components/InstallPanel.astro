---
/**
 * The full install panel in "How it works": the MCP server, with every agent's own steps. The
 * hero and the last section carry the short version, the URL alone (InstallQuick.astro).
 * Everything it prints comes from content/site.ts.
 */
import CommandBox from './CommandBox.astro';
import Stepper from './Stepper.astro';
import { mcpAgents, hero, signIn } from '../content/site';

interface Props {
  /** Id prefix, so the copies in the "How to use" dialogs don't clash with the one in "How it works". */
  prefix?: string;
}

const { prefix: p = 'how' } = Astro.props;
---

<div class="install" data-install aria-labelledby={`${p}-install-title`}>
  <div class="install__head">
    <h3 class="h3" id={`${p}-install-title`}>Pick how to connect it</h3>
    <p class="install__free">{hero.free}</p>
  </div>

  <div class="install__body">
    <div class="install__agents" role="group" aria-label="Your agent">
      {
        mcpAgents.map((a, i) => (
          <button type="button" data-agent={a.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {a.label}
          </button>
        ))
      }
    </div>
    {
      mcpAgents.map((a, i) => (
        <div data-agent-panel={a.id} hidden={i !== 0}>
          {a.note && <p>{a.note}</p>}
          <CommandBox value={a.value} name={`the ${a.label} setup`} />
          {a.deeplink && (
            <p class="install__deeplink">
              Or <a class="link" href={a.deeplink.href}>{a.deeplink.label}</a> in one click.
            </p>
          )}
          {/* The agent's own steps, then the sign-in every agent goes through, one at a time. */}
          <Stepper steps={[...(a.steps ?? []), ...signIn.steps]} label={a.steps ? undefined : signIn.title} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .install {
    display: grid;
    gap: 1.125rem;
    width: min(40rem, 100%);
    margin-inline: auto;
    padding: 1.75rem;
    color: var(--ink);
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .install__head {
    display: grid;
    gap: 0.125rem;
  }

  .install__free {
    color: var(--ink-muted);
    font-size: 1rem;
  }

  .install__body {
    display: grid;
    gap: 0.875rem;
    font-size: 1.0625rem;
    line-height: 1.625rem;
    min-width: 0;
  }

  .install__agents {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .install__agents button {
    padding: 0.375rem 0.75rem;
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: 62.4375rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .install__agents button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  [data-agent-panel] {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  [data-agent-panel][hidden] {
    display: none;
  }

  .install__deeplink {
    font-size: 1rem;
    color: var(--ink-muted);
  }

  @media (max-width: 520px) {
    .install {
      padding: 1.25rem;
    }
  }
</style>
