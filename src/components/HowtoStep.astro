---
/** One numbered step of an install guide, with its screenshot under it when there is one. */
import type { HowtoStep } from '../content/site';

interface Props {
  step: HowtoStep;
}

const { step } = Astro.props;
const shot = step.shot;
---

<li>
  {step.text}
  {
    shot && (
      <img
        class="shot"
        src={shot.src.src}
        width={shot.width}
        height={Math.round((shot.width * shot.src.height) / shot.src.width)}
        alt={shot.alt}
        loading="lazy"
        decoding="async"
      />
    )
  }
</li>

<style>
  /* A screenshot of the step, taken in the real app, at about the size it is on screen. */
  .shot {
    display: block;
    max-width: 100%;
    height: auto;
    margin-top: 0.5rem;
    border: 1px solid var(--hairline);
    border-radius: 0.625rem;
  }
</style>
