---
import MrrChart from './MrrChart.astro';
import { series, usd, toArr, monthYear, fullDate } from '../lib/chart';
import { proof, proofSection, asOfLabel } from '../content/site';
---

<section class="band" id="proof">
  <div class="wrap">
    <div class="band__head">
      <h2 class="h2">{proofSection.title}</h2>
      <p>{proofSection.sub}</p>
    </div>

    <figure class="card" data-unit="mrr">
      <figcaption class="card__head">
        <div>
          <p class="card__label">
            <span data-unit-show="mrr">{proofSection.chartTitle}</span>
            <span data-unit-show="arr">{proofSection.chartTitleArr}</span>
          </p>
          <p class="card__value">
            <span data-unit-show="mrr">{usd(proof.mrr)}</span>
            <span data-unit-show="arr">{usd(toArr(proof.mrr))}</span>
          </p>
        </div>
        <div class="card__side">
          <div class="card__units" role="group" aria-label="Show revenue as" data-units hidden>
            <button type="button" data-unit-pick="mrr" aria-pressed="true">MRR</button>
            <button type="button" data-unit-pick="arr" aria-pressed="false">ARR</button>
          </div>
          <p class="card__meta">
            As of {asOfLabel}.
            <a class="link" href={proof.proofUrl} rel="noopener">{proofSection.proofLink}</a>
          </p>
        </div>
      </figcaption>

      <MrrChart variant="wide" />
      <MrrChart variant="narrow" />

      <details class="card__table">
        <summary>See the numbers as a table</summary>
        <div class="card__scroll">
          <table>
            <caption class="sr-only">Postiz monthly recurring revenue by month</caption>
            <thead>
              <tr>
                <th scope="col">Month</th>
                <th scope="col"><span data-unit-show="mrr">MRR</span><span data-unit-show="arr">ARR</span></th>
              </tr>
            </thead>
            <tbody>
              {
                series.map((p, i) => (
                  <tr>
                    <th scope="row">{i === series.length - 1 ? asOfLabel : p.date.endsWith('-01') ? monthYear(p.t) : fullDate(p.t)}</th>
                    <td>
                      <span data-unit-show="mrr">{usd(p.mrr)}</span>
                      <span data-unit-show="arr">{usd(toArr(p.mrr))}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="card__fine">{proofSection.fine}</p>
      </details>
    </figure>

  </div>
</section>

<style>
  .card {
    max-width: 62.5rem;
    margin-inline: auto;
    padding: clamp(1.125rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }

  .card__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* MRR or ARR: every figure on the card is there twice, and data-unit shows one. */
  .card :global([data-unit-show='arr']),
  .card[data-unit='arr'] :global([data-unit-show='mrr']) {
    display: none;
  }

  .card[data-unit='arr'] :global([data-unit-show='arr']) {
    display: revert;
  }

  .card__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    align-self: stretch;
  }

  .card__units {
    display: flex;
    gap: 0.375rem;
  }

  .card__units[hidden] {
    display: none;
  }

  .card__units button {
    padding: 0.25rem 0.75rem;
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: 62.4375rem;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .card__units button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  @media (max-width: 700px) {
    .card__side {
      align-items: flex-start;
    }
  }

  .card__label {
    font-size: 1rem;
    color: var(--ink-muted);
  }

  /* The one hero figure on the page: same sans as everything else, proportional digits. */
  .card__value {
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.15;
  }

  .card__meta {
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  .card__meta .link {
    margin-left: 0.25rem;
    white-space: nowrap;
  }

  .card__table {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  .card__table summary {
    cursor: pointer;
    color: var(--ink-muted);
    width: fit-content;
  }

  .card__scroll {
    max-height: 20rem;
    overflow: auto;
    margin-top: 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 0.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.375rem 0.875rem;
    text-align: left;
    font-weight: 400;
    border-bottom: 1px solid var(--shade);
  }

  thead th {
    position: sticky;
    top: 0;
    background: #fff;
    font-weight: 700;
  }

  td {
    text-align: right;
  }

  thead th:last-child {
    text-align: right;
  }

  .card__fine {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

</style>
