---
/**
 * The install block of the hero and of the last section: the one line to copy, the MCP
 * server's URL. No instructions here: every agent's steps are in "How it works"
 * (InstallPanel.astro). Everything it prints comes from content/site.ts.
 */
import CommandBox from './CommandBox.astro';
import { install } from '../content/site';
---

<div class="quick" data-install>
  <CommandBox value={install.mcpUrl} name="the MCP server URL" />
</div>

<style>
  /* The line to copy, centered. */
  .quick {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    width: min(100%, 36rem);
  }

  /* The line to copy sits on a card of its own, big enough to read as the thing to take away. */
  .quick :global(.cmd) {
    width: 100%;
    min-height: 3.25rem;
    border-radius: 0.75rem;
    box-shadow: var(--shadow-card);
    text-align: left;
  }

  .quick :global(.cmd__text) {
    align-self: center;
    padding: 0.8125rem 1.25rem;
    font-size: 0.875rem;
    line-height: 1.4375rem;
    /* A long line wraps here; scrolling sideways inside a hero is nobody's idea of fun. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .quick :global(.cmd__copy) {
    min-width: 5rem;
    border-radius: 0 0.75rem 0.75rem 0;
    font-size: 0.875rem;
  }

  @media (max-width: 520px) {
    .quick :global(.cmd__text) {
      padding: 0.75rem 0.875rem;
      font-size: 0.8125rem;
      line-height: 1.3125rem;
    }
  }
</style>
